;
; ZnunyCodePolicy Main Configuration
;
; Extensions Configuration Files:
; The znuny.CodePolicy.pl script automatically loads extensions .tidyallrc files
; from this directory (Kernel/TidyAll/), if they exist:
;   - custom.tidyallrc
;   - Any other *.tidyallrc files
;
; These files are loaded in alphabetical order after the main tidyallrc
; and enable modular plugin configurations.
;
; Extension plugins can be placed in the Kernel/TidyAll/Plugin directory
; and configured in the corresponding .tidyallrc files.
;
; Plugin placement
;
; The directory Kernel/TidyAll/Plugin/Znuny/<Section>/ matches the section
; name below. The section is the kind of check. select is only the set of
; files that contain the thing being checked. The file extension does not
; pick the section.
;
; Put a new plugin in the first section that fits:
;   - Deprecated, when an old name or call must be renamed or removed.
;     select follows the file type that still contains that old name.
;   - A file-type section (Perl, XML, SOPM, SQL, TT, JavaScript, PO,
;     Documentation, SeleniumTest, UnitTest, RichTextEditor), when the
;     check is about that file type and the API is still current.
;   - CodeStyle, Common, Config, Legal, Translation, Whitespace, Autoload
;     or Misc. The note on that section says what belongs there.
;
; Global ignores
;

; Ignore all CPAN files.
ignore = Kernel/cpan-lib/**/* Custom/Kernel/cpan-lib/**/*

; Ignore all dynamic/temporary files.
ignore = var/{article,log,run,sessions,spool,tmp,virtualfs}/**/*

; Ignore thirdparty content.
ignore = **/thirdparty/**/*

; Ignore Loader cache files.
ignore = **/{js-cache,css-cache}/**/*

; Ignore test data files.
ignore = scripts/test/sample/**/*

; Ignore vagrant instance contents of the CI provisioner.
ignore = var/Vagrant/Instances/**/*

; node.js packages
ignore = **/node_modules/**/*

; TidyAll and plugins
ignore = Kernel/TidyAll/**/*

; Ignore all extensions.
ignore = Extensions/**/*

;
; Autoload
; Modules loaded from Kernel/Autoload.
;
[+TidyAll::Plugin::Znuny::Autoload::ObjectManagerDisabled]
select = Kernel/Autoload/**/*.pm

